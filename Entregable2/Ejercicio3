import random
from utilidades import validar_distancia, limpiar_pantalla


def mostrar_carrera(distancia, pos_a, pos_b):
    """Muestra el estado actual de la carrera"""
    print("\n" + "=" * (distancia + 10))
    print("🎌 CARRERA DE COCHES 🎌")
    print("=" * (distancia + 10) + "\n")

    # Mostrar meta
    print("🎯 META: " + " " * (distancia - 6) + "|FIN|\n")

    # Mostrar pista del coche A (Jugador)
    pista_a = " " * pos_a + "🚗 A" + " " * (distancia - pos_a - 4)
    print(f"Jugador:  |{pista_a}| ({pos_a}/{distancia})")

    # Mostrar pista del coche B (Máquina)
    pista_b = " " * pos_b + "🚙 B" + " " * (distancia - pos_b - 4)
    print(f"Máquina:  |{pista_b}| ({pos_b}/{distancia})")

    # Línea de meta visual
    print("\n" + "-" * (distancia + 10))


def avanzar_coche(pos_actual, distancia):
    """Avanza un coche entre 1 y 3 posiciones"""
    avance = random.randint(1, 3)
    nueva_pos = pos_actual + avance

    # No pasarse de la meta
    if nueva_pos > distancia:
        nueva_pos = distancia

    return nueva_pos, avance


def main():
    """Función principal del juego"""
    print("=" * 50)
    print("        🏁 CARRERA DE COCHES 🏁")
    print("=" * 50)

    # 1) Pedir y validar distancia
    while True:
        distancia_input = input("\nIntroduce la distancia de la carrera (30-60): ")
        distancia, es_valida = validar_distancia(distancia_input)

        if es_valida:
            print(f"\n✅ Carrera configurada a {distancia} casillas!")
            break
        else:
            print("❌ Distancia no válida. Debe ser un número entre 30 y 60.")

    # Inicializar posiciones
    pos_a = 0  # Coche jugador
    pos_b = 0  # Coche máquina
    turno = 1

    print("\n" + "=" * 50)
    print("¡PREPARADOS! Presiona ENTER para cada turno.")
    print("=" * 50)

    # Bucle principal del juego
    while pos_a < distancia and pos_b < distancia:
        input(f"\n🎮 Turno {turno} - Presiona ENTER para avanzar...")
        limpiar_pantalla()

        # Turno del jugador (Coche A)
        print("\n🎮 TURNO DEL JUGADOR 🎮")
        pos_a, avance_a = avanzar_coche(pos_a, distancia)
        print(f"🚗 Coche A avanza {avance_a} posiciones")

        # Turno de la máquina (Coche B)
        print("\n🤖 TURNO DE LA MÁQUINA 🤖")
        pos_b, avance_b = avanzar_coche(pos_b, distancia)
        print(f"🚙 Coche B avanza {avance_b} posiciones")

        # Mostrar estado actual
        mostrar_carrera(distancia, pos_a, pos_b)

        # Verificar si alguien ganó
        if pos_a >= distancia and pos_b >= distancia:
            print("\n" + "=" * 50)
            print("🏆 ¡EMPATE! Ambos llegaron a la vez 🏆")
            print("=" * 50)
            break
        elif pos_a >= distancia:
            print("\n" + "=" * 50)
            print("🏆 ¡FELICIDADES! ¡GANASTE! 🏆")
            print("=" * 50)
            break
        elif pos_b >= distancia:
            print("\n" + "=" * 50)
            print("😞 ¡PERDISTE! La máquina ganó 😞")
            print("=" * 50)
            break

        turno += 1

    # Estadísticas finales
    print(f"\n📊 RESUMEN DE LA CARRERA:")
    print(f"   Distancia total: {distancia} casillas")
    print(f"   Turnos jugados: {turno}")
    print(f"   Posición final Jugador: {pos_a}/{distancia}")
    print(f"   Posición final Máquina: {pos_b}/{distancia}")

    input("\nPresiona ENTER para salir...")


# Punto de entrada del programa
if __name__ == "__main__":
    main()
